{
  "name": "lmup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "serve:build": "node scripts/serve-static.mjs",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "audit:security": "npm audit --audit-level=moderate",
    "lint": "eslint .",
    "check": "svelte-kit sync && svelte-check",
    "verify": "npm run lint && npm run check && npm run test:run && npm run build",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-svelte": "^3.13.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.2.6",
    "postcss": "^8.5.32",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.3.3",
    "svelte-eslint-parser": "^1.4.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.70.3",
    "chart.js": "^4.5.1",
    "dexie": "^4.2.1",
    "file-saver": "^2.0.5",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "picomatch@2.3.1": "2.3.2"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": "eslint --fix --no-warn-ignored",
    "*.{js,ts,svelte,json,css,md}": "prettier --write"
  }
}
