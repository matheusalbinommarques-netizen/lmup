{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Level Me Up",
  "version": "0.1.0",
  "identifier": "net.matheusalbinommarques.levelmeup",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Level Me Up!",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/levelmeup.ico", "icons/levelmeup.png"]
  }
}
