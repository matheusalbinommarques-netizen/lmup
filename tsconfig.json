{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": ["$app/types", "svelte", "vite/client", "vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src", "tests", "vite.config.js"],
  "exclude": ["src/service-worker"]
}
